-- ---------------------------------------------------------------------------
-- Horários: segunda a sexta (weekday 1 a 5)
-- ---------------------------------------------------------------------------
WITH schedule_data AS (
    SELECT d.user_id AS doctor_id, l.id AS location_id,
           v.start_time, v.end_time
    FROM (VALUES
        ('123456', 'Med.na Unidade Centro',      '08:00'::TIME, '18:00'::TIME),
        ('234567', 'Med.na Unidade Zona Leste',   '09:00'::TIME, '17:00'::TIME),
        ('345678', 'Med.na Unidade Zona Oeste',   '08:00'::TIME, '16:00'::TIME)
    ) AS v(crm, location_name, start_time, end_time)
    JOIN public.doctors d ON d.crm = v.crm
    JOIN public.locations l ON l.name = v.location_name
),
weekdays AS (
    SELECT generate_series(1, 5)::SMALLINT AS weekday
)
INSERT INTO public.doctor_schedules
    (doctor_id, location_id, weekday, start_time, end_time, slot_minutes)
SELECT s.doctor_id, s.location_id, w.weekday, s.start_time, s.end_time, 30
FROM schedule_data s
CROSS JOIN weekdays w
WHERE NOT EXISTS (
    SELECT 1
    FROM public.doctor_schedules existing
    WHERE existing.doctor_id = s.doctor_id
      AND existing.location_id = s.location_id
      AND existing.weekday = w.weekday
      AND existing.start_time = s.start_time
      AND existing.end_time = s.end_time
);

