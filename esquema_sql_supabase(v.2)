-- ============================================================================
-- SCHEMA - Med.na
-- PostgreSQL / Supabase
-- ============================================================================

-- ---------------------------------------------------------------------------
-- ENUMS: ignora tipos que já existam em public
-- ---------------------------------------------------------------------------
DO $$ BEGIN
    CREATE TYPE public.user_role AS ENUM ('PATIENT', 'EMPLOYEE', 'DOCTOR', 'ADMIN');
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

DO $$ BEGIN
    CREATE TYPE public.appointment_status AS ENUM ('SCHEDULED', 'CONFIRMED', 'COMPLETED', 'CANCELED');
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

DO $$ BEGIN
    CREATE TYPE public.appointment_mode AS ENUM ('IN_PERSON', 'TELEMEDICINE');
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

DO $$ BEGIN
    CREATE TYPE public.insurance_card_status AS ENUM ('ACTIVE', 'EXPIRED', 'SUSPENDED');
EXCEPTION WHEN duplicate_object THEN NULL;
END $$;

-- ---------------------------------------------------------------------------
-- USUÁRIOS E PERFIS
-- ---------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.users (
    id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email         VARCHAR(255) NOT NULL UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    role          public.user_role NOT NULL,
    first_name    VARCHAR(100) NOT NULL,
    last_name     VARCHAR(100) NOT NULL,
    phone         VARCHAR(20),
    is_active     BOOLEAN NOT NULL DEFAULT TRUE,
    created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE TABLE IF NOT EXISTS public.patients (
    user_id       UUID PRIMARY KEY REFERENCES public.users(id) ON DELETE CASCADE,
    cpf           VARCHAR(11) NOT NULL UNIQUE,
    birth_date    DATE NOT NULL,
    address_st    VARCHAR(255),
    address_city  VARCHAR(100),
    address_state CHAR(2)
);

CREATE TABLE IF NOT EXISTS public.employees (
    user_id   UUID PRIMARY KEY REFERENCES public.users(id) ON DELETE CASCADE,
    cpf       VARCHAR(11) NOT NULL UNIQUE,
    hire_date DATE NOT NULL DEFAULT CURRENT_DATE,
    job_title VARCHAR(100)
);

CREATE TABLE IF NOT EXISTS public.doctors (
    user_id              UUID PRIMARY KEY REFERENCES public.users(id) ON DELETE CASCADE,
    crm                  VARCHAR(20) NOT NULL,
    crm_state            CHAR(2) NOT NULL,
    cpf                  VARCHAR(11) NOT NULL UNIQUE,
    bio                  TEXT,
    telemedicine_enabled BOOLEAN NOT NULL DEFAULT TRUE,
    UNIQUE (crm, crm_state)
);

-- ---------------------------------------------------------------------------
-- MÉDICOS E ESPECIALIDADES
-- ---------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.specialties (
    id   UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(120) NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS public.doctor_specialties (
    doctor_id    UUID NOT NULL REFERENCES public.doctors(user_id) ON DELETE CASCADE,
    specialty_id UUID NOT NULL REFERENCES public.specialties(id) ON DELETE CASCADE,
    PRIMARY KEY (doctor_id, specialty_id)
);

CREATE TABLE IF NOT EXISTS public.locations (
    id            UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name          VARCHAR(150) NOT NULL,
    address_st    VARCHAR(255) NOT NULL,
    address_city  VARCHAR(100) NOT NULL,
    address_state CHAR(2) NOT NULL,
    phone         VARCHAR(20)
);

CREATE TABLE IF NOT EXISTS public.doctor_locations (
    doctor_id   UUID NOT NULL REFERENCES public.doctors(user_id) ON DELETE CASCADE,
    location_id UUID NOT NULL REFERENCES public.locations(id) ON DELETE CASCADE,
    PRIMARY KEY (doctor_id, location_id)
);

CREATE TABLE IF NOT EXISTS public.doctor_schedules (
    id           UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    doctor_id    UUID NOT NULL REFERENCES public.doctors(user_id) ON DELETE CASCADE,
    location_id  UUID REFERENCES public.locations(id) ON DELETE SET NULL,
    weekday      SMALLINT NOT NULL CHECK (weekday BETWEEN 0 AND 6),
    start_time   TIME NOT NULL,
    end_time     TIME NOT NULL,
    slot_minutes SMALLINT NOT NULL DEFAULT 30 CHECK (slot_minutes > 0),
    CHECK (end_time > start_time)
);

-- ---------------------------------------------------------------------------
-- PLANOS DE SAÚDE E CONVÊNIOS
-- ---------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.health_insurances (
    id       UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name     VARCHAR(150) NOT NULL UNIQUE,
    ans_code VARCHAR(20) UNIQUE,
    cnpj     VARCHAR(14) UNIQUE
);

CREATE TABLE IF NOT EXISTS public.patient_insurances (
    id           UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id   UUID NOT NULL REFERENCES public.patients(user_id) ON DELETE CASCADE,
    insurance_id UUID NOT NULL REFERENCES public.health_insurances(id),
    card_number  VARCHAR(50) NOT NULL,
    valid_until  DATE,
    status       public.insurance_card_status NOT NULL DEFAULT 'ACTIVE',
    UNIQUE (insurance_id, card_number)
);

CREATE TABLE IF NOT EXISTS public.doctor_insurances (
    doctor_id    UUID NOT NULL REFERENCES public.doctors(user_id) ON DELETE CASCADE,
    insurance_id UUID NOT NULL REFERENCES public.health_insurances(id) ON DELETE CASCADE,
    PRIMARY KEY (doctor_id, insurance_id)
);

-- ---------------------------------------------------------------------------
-- CONSULTAS E AGENDAMENTOS
-- ---------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.appointments (
    id              UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    patient_id      UUID NOT NULL REFERENCES public.patients(user_id),
    doctor_id       UUID NOT NULL REFERENCES public.doctors(user_id),
    specialty_id    UUID REFERENCES public.specialties(id),
    location_id     UUID REFERENCES public.locations(id),
    insurance_id    UUID REFERENCES public.patient_insurances(id),
    scheduled_at    TIMESTAMPTZ NOT NULL,
    duration_min    SMALLINT NOT NULL DEFAULT 30,
    mode            public.appointment_mode NOT NULL DEFAULT 'IN_PERSON',
    status          public.appointment_status NOT NULL DEFAULT 'SCHEDULED',
    price           NUMERIC(10,2),
    telemedicine_url VARCHAR(500),
    cancel_reason   TEXT,
    canceled_at     TIMESTAMPTZ,
    canceled_by     UUID REFERENCES public.users(id),
    created_by      UUID REFERENCES public.employees(user_id),
    created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at      TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_appointments_patient
    ON public.appointments (patient_id, scheduled_at DESC);

CREATE INDEX IF NOT EXISTS idx_appointments_doctor
    ON public.appointments (doctor_id, scheduled_at DESC);

CREATE INDEX IF NOT EXISTS idx_appointments_status
    ON public.appointments (status)
    WHERE status IN ('SCHEDULED', 'CONFIRMED');

-- ---------------------------------------------------------------------------
-- PRONTUÁRIOS
-- ---------------------------------------------------------------------------
CREATE TABLE IF NOT EXISTS public.medical_records (
    id             UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    appointment_id UUID NOT NULL UNIQUE REFERENCES public.appointments(id) ON DELETE CASCADE,
    patient_id     UUID NOT NULL REFERENCES public.patients(user_id),
    doctor_id      UUID NOT NULL REFERENCES public.doctors(user_id),
    anamnesis      TEXT,
    diagnosis      TEXT,
    notes          TEXT,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at     TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_records_patient
    ON public.medical_records (patient_id, created_at DESC);

CREATE TABLE IF NOT EXISTS public.prescriptions (
    id          UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    record_id   UUID NOT NULL REFERENCES public.medical_records(id) ON DELETE CASCADE,
    medications JSONB NOT NULL,
    issued_at   TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ---------------------------------------------------------------------------
-- updated_at automático
-- ---------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION public.set_updated_at()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    NEW.updated_at := now();
    RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_users_updated ON public.users;
CREATE TRIGGER trg_users_updated
    BEFORE UPDATE ON public.users
    FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();

DROP TRIGGER IF EXISTS trg_appointments_updated ON public.appointments;
CREATE TRIGGER trg_appointments_updated
    BEFORE UPDATE ON public.appointments
    FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();

DROP TRIGGER IF EXISTS trg_records_updated ON public.medical_records;
CREATE TRIGGER trg_records_updated
    BEFORE UPDATE ON public.medical_records
    FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();

